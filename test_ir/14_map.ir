// map(MPTYPE/MPMAKE/MSET/MGET/MPKEYS)のテスト
MPTYPE	^StrIntMap	^string	^int
SLTYPE	^StrSlice	^string

FUNC	!main	:
	VAR	%m	^StrIntMap
	VAR	%v	^int
	VAR	%ok	^bool
	VAR	%keys	^StrSlice

	MPMAKE	%m	^StrIntMap
	MSET	%m	"one"	1
	MSET	%m	"two"	2

	MGET	%v	%m	"one"
	MGET	%v	%ok	%m	"three"

	MPKEYS	%keys	%m

	RET
ENDFUNC
