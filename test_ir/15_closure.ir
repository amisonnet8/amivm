// クロージャー(CLOS/ENDCLOS)のテスト。callname/valueへの関数拡張のテストも含む
FNTYPE	^BinOp	^int	^int	:	^int
FNTYPE	^Provider	:	^int
FNTYPE	^IntOp	^int	:	^int

GVAR	@globalAdder	^BinOp

FUNC	!triple	^int	:	^int
	VAR	%r	^int
	MUL	%r	$1	3
	RET	%r
ENDFUNC

// パラメータで受け取った関数値(クロージャー等)を、その関数の中で$1のまま
// callnameとして直接呼び出せることのテスト
FUNC	!applyBinOp	^BinOp	^int	^int	:	^int
	VAR	%r	^int
	CALL	%r	:	$1	$2	$3
	RET	%r
ENDFUNC

// CLOSの代入先(shallow)に$N(関数パラメータ)を使えることのテスト。
// パラメータとして受け取ったクロージャーを、関数内で新しいクロージャーに差し替えてから呼ぶ
FUNC	!replaceAndCall	^BinOp	^int	^int	:	^int
	VAR	%r	^int
	CLOS	$1	^int	^int	:	^int
		VAR	%s	^int
		ADD	%s	&1	&2
		RET	%s
	ENDCLOS
	CALL	%r	:	$1	$2	$3
	RET	%r
ENDFUNC

FUNC	!main	:
	VAR	%base	^int
	VAR	%adder	^BinOp
	VAR	%counter	^Provider
	VAR	%count	^int
	VAR	%result	^int
	VAR	%c1	^int
	VAR	%c2	^int
	VAR	%viaParam	^int
	VAR	%fn	^IntOp
	VAR	%viaValue	^int
	VAR	%viaReplacedParam	^int
	VAR	%viaGlobal	^int

	SET	%base	100
	SET	%count	0

	CLOS	%adder	^int	^int	:	^int
		VAR	%sum	^int
		ADD	%sum	&1	&2
		ADD	%sum	%sum	%base
		RET	%sum
	ENDCLOS

	CALL	%result	:	%adder	1	2

	CLOS	%counter	:	^int
		ADD	%count	%count	1
		RET	%count
	ENDCLOS

	CALL	%c1	:	%counter
	CALL	%c2	:	%counter

	// %adderをパラメータとして渡し、呼び出し先で$1のまま呼び出す(callname拡張)
	CALL	%viaParam	:	!applyBinOp	%adder	5	6

	// AMIVM内定義関数そのものを値として変数に代入し、後から呼び出す(value拡張)
	SET	%fn	!triple
	CALL	%viaValue	:	%fn	7

	// CLOSの代入先(shallow)に$N(関数パラメータ)を使えることのテスト
	CALL	%viaReplacedParam	:	!replaceAndCall	%adder	8	9

	// CLOSの代入先(shallow)に@xxx_123(パッケージレベル変数)を使えることのテスト。
	// callnameに@xxx_123を使えることのテストも兼ねる
	CLOS	@globalAdder	^int	^int	:	^int
		VAR	%s	^int
		ADD	%s	&1	&2
		RET	%s
	ENDCLOS
	CALL	%viaGlobal	:	@globalAdder	10	20

	RET
ENDFUNC
