// 変数定義(VAR/GVAR)のテスト。文字列・ルーンリテラルのエスケープシーケンスの
// テストも含む(ダブルクォート内の\"、ルーンの名前付きエスケープ・\U・非ASCII文字)
GVAR	@gCounter	^int
GVAR	@gName	^string

FUNC	!main	:
	VAR	%i	^int
	VAR	%f	^float64
	VAR	%s	^string
	VAR	%b	^bool
	VAR	%r	^rune
	VAR	%arr	^[5]int
	VAR	%pi	^*int
	VAR	%quoted	^string
	VAR	%escaped	^string
	VAR	%rNewline	^rune
	VAR	%rQuote	^rune
	VAR	%rUnicode	^rune
	VAR	%rEmoji	^rune

	SET	%i	42
	SET	%f	3.14
	SET	%s	"hello"
	SET	%b	true
	SET	%r	'A'
	ADDR	%pi	%i

	SET	@gCounter	1
	SET	@gName	"world"

	// 文字列リテラル内のエスケープシーケンス(\"を含む)のテスト
	SET	%quoted	"say \"hi\" now"
	SET	%escaped	"tab\tnewline\n"

	// ルーンリテラルのエスケープシーケンス(\n)・エスケープされたクォート(\')・
	// 非ASCII文字・\U(8桁hexのUnicodeコードポイント)のテスト
	SET	%rNewline	'\n'
	SET	%rQuote	'\''
	SET	%rUnicode	'あ'
	SET	%rEmoji	'\U0001F600'

	RET
ENDFUNC
