// SPAWN・チャネル・SELのテスト。CASESEND/CASERECV/DEFAULTがブロック本体を
// 持つ新仕様(labelを取らず、次のケースかENDSELまでが本体)のテストを兼ねる
CHTYPE	^IntChan	^int

FUNC	!worker	^IntChan	:
	CHSEND	$1	42
ENDFUNC

FUNC	!main	:
	VAR	%ch	^IntChan
	VAR	%ch2	^IntChan
	VAR	%v	^int
	VAR	%v2	^int
	VAR	%result	^string
	VAR	%result2	^string

	CHMAKE	%ch	^IntChan	1
	CHMAKE	%ch2	^IntChan	1

	SPAWN	!worker	%ch

	CHRECV	%v	%ch

	SEL
	CASESEND	%ch2	7
		SET	%result	"sent"
	DEFAULT
		SET	%result	"not sent"
	ENDSEL

	SEL
	CASERECV	%v2	%ch2
		SET	%result2	"received"
	DEFAULT
		SET	%result2	"empty"
	ENDSEL

	RET
ENDFUNC
